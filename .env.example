PORT=3001
VITE_API_BASE_URL=/api

# Where the owner's generated password is emailed. Without these the outbox stays
# the only copy of that password, so they are not optional on a live deployment.
# Port 465 implies implicit TLS; any other port negotiates STARTTLS, which is what
# Gmail and most providers want.
#
# These are the `SMTP_*` names this project reads. The `MAIL_*` spelling below is
# accepted as an alias for each one, because that is the shape most hosting
# providers and framework templates use - `SMTP_*` wins where both are set, so
# either block works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Set to true when the provider needs implicit TLS on a port other than 465.
SMTP_SECURE=false
# Defaults to SMTP_USER, which is usually right for a dedicated sending mailbox.
MAIL_FROM=
# The sender name shown in the recipient's inbox. Quoted and bracketed for you.
MAIL_FROM_NAME=

# The same settings under the `MAIL_*` names, left as an alternative rather than a
# second copy to keep in sync. Comment these out to use the `SMTP_*` block above.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# tls negotiates STARTTLS after connecting (port 587). ssl means implicit TLS
# (port 465). An unrecognised word falls back to the port's own convention.
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=