DATABASE_URL=postgresql://glow_grace:change-this-local-password@localhost:5435/glow_grace
POSTGRES_DB=glow_grace
POSTGRES_USER=glow_grace
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5435
PORT=3001
VITE_API_BASE_URL=/api

PRODUCTION_DATABASE_URL=postgresql://neondb_owner:replace-me@ep-your-project-pooler.your-region.aws.neon.tech/neondb?channel_binding=require&sslmode=require

LOCAL_DATABASE_SSL=disable
DATABASE_SSL=require
DATABASE_POOL_MAX=1
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=8000
DATABASE_STATEMENT_TIMEOUT_MS=0
ALLOW_REMOTE_DATABASE=false

# Where the owner's generated password is emailed. Without these the outbox stays
# the only copy of that password, so they are not optional on a live deployment.
# Port 465 implies implicit TLS; any other port negotiates STARTTLS, which is what
# Gmail and most providers want.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Set to true when the provider needs implicit TLS on a port other than 465.
SMTP_SECURE=false
# Defaults to SMTP_USER, which is usually right for a dedicated sending mailbox.
MAIL_FROM=

# Read by scripts/reset-admin-password.ts only. The server never sees it: the
# script hashes the value, stores the hash, and the plaintext is not needed again.
# Set it in .env, run the script, and delete the line afterwards.
#
#   OWNER_PINNED_PASSWORD=...
#   npx tsx scripts/reset-admin-password.ts --email glowngracebiz@gmail.com \
#     --hold-until 2026-10-10T23:59:59Z
#
# --hold-until is the only way to keep the weekly rotation off a password, it
# applies to the owner account alone, and it is capped at 30 days. Leave it out
# and the rotation replaces the password a week later regardless.
OWNER_PINNED_PASSWORD=
