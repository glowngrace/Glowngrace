PORT=3001
VITE_API_BASE_URL=/api

# Where the owner's confirmation is emailed when a password is saved, and where the
# seed password goes on a machine seeded for the first time. Without these the save
# still works - the password is on the owner's own screen - but the confirmation
# never leaves the outbox, so the owner is not told their credential changed.
# Port 465 implies implicit TLS; any other port negotiates STARTTLS, which is what
# Gmail and most providers want.
#
# These are the `SMTP_*` names this project reads. The `MAIL_*` spelling below is
# accepted as an alias for each one, because that is the shape most hosting
# providers and framework templates use - `SMTP_*` wins where both are set, so
# either block works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Set to true when the provider needs implicit TLS on a port other than 465.
SMTP_SECURE=false
# Defaults to SMTP_USER, which is usually right for a dedicated sending mailbox.
MAIL_FROM=
# The sender name shown in the recipient's inbox. Quoted and bracketed for you.
MAIL_FROM_NAME=

# The same settings under the `MAIL_*` names, left as an alternative rather than a
# second copy to keep in sync. Comment these out to use the `SMTP_*` block above.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# tls negotiates STARTTLS after connecting (port 587). ssl means implicit TLS
# (port 465). An unrecognised word falls back to the port's own convention.
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=

# Tests only - not read by the application.
#
# The live owner-password spec (e2e/superadmin-password-live.spec.ts) has to know
# the password that currently opens the owner account. It tries the seed credential
# still sitting in the outbox first, and this one before that. Once an owner saves a
# password from /superadmin/ggpass no server-side record of it exists, so without
# this the file reports itself as skipped rather than failing on a sign-in timeout.
# E2E_OWNER_PASSWORD=