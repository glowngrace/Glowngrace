{
  "name": "glow-and-grace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "tsx scripts/start.ts",
    "start:api": "tsx server/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ui": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:dist": "playwright test --config playwright.dist.config.ts",
    "preview:dist": "tsx scripts/serve-dist.ts",
    "db:up": "tsx scripts/local-database.ts up",
    "db:down": "tsx scripts/local-database.ts down",
    "db:status": "tsx scripts/local-database.ts status",
    "db:logs": "tsx scripts/local-database.ts logs",
    "db:wait": "tsx scripts/local-database.ts wait",
    "db:reset": "tsx scripts/local-database.ts reset",
    "db:destroy": "tsx scripts/local-database.ts destroy",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:migrate:production": "tsx scripts/migrate-database.ts production",
    "db:check": "tsx scripts/check-database.ts",
    "db:seed": "tsx scripts/seed-local-database.ts",
    "db:sync": "tsx scripts/sync-neon-to-local.ts",
    "neon:provision": "tsx scripts/neon-provision.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^5.0.2"
  }
}
