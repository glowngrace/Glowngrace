# Copy to .env.local and fill in. `.env.local` is git-ignored and is the only
# file that holds real passwords.
#
#   cp .env.local.example .env.local
#
# `.env.local` is loaded first and wins over `.env`, so the local Docker
# credentials here stay out of the file that is shared with the deployment.

# ---------------------------------------------------------------------------
# Which database the running app talks to
# ---------------------------------------------------------------------------
# true  -> the local Docker Postgres from local-dev/docker-compose.yml.
# false -> whatever runtime connection string is present, which on Vercel is the
#          one Neon injects, and at home is PRODUCTION_DATABASE_URL.
USE_LOCAL_DATABASE=true

# ---------------------------------------------------------------------------
# Local Docker database (the development and testing target)
# ---------------------------------------------------------------------------
# Port 5435 rather than 5432 so a Postgres you already run on your own machine
# keeps 5432 to itself.
POSTGRES_DB=glow_grace
POSTGRES_USER=glow_grace
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5435
DATABASE_URL=postgresql://glow_grace:change-this-local-password@localhost:5435/glow_grace
# The container speaks plain TCP on localhost, so there is no certificate to
# verify and asking for one would fail.
LOCAL_DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Neon production database
# ---------------------------------------------------------------------------
# The resource `npm run neon:provision` creates. Quota permitting, the script
# creates this project and prints a PRODUCTION_DATABASE_URL to paste here.
NEON_PROJECT_NAME=neon-glowngraceproddb
NEON_REGION_ID=aws-ap-southeast-2
NEON_PG_VERSION=16

# Only needed by `npm run neon:provision`. Create a key at
# https://console.neon.tech/app/settings/api-keys and leave it out of git.
NEON_API_KEY=
# Only needed to provision with a personal key rather than an organisation key.
NEON_ORG_ID=

# The pooled connection string. The `-pooler.` host is the one that matters:
# Neon's pooler multiplexes every request over one connection and holds the
# compute down to zero in between, which is what keeps a local sync from
# spending the monthly quota.
NEON_DATABASE_URL=
# Fallback name for the same thing. Either variable configures the remote.
PRODUCTION_DATABASE_URL=
# Neon is always reached over TLS, and the certificate is verified.
DATABASE_SSL=require

# ---------------------------------------------------------------------------
# The Neon -> local sync
# ---------------------------------------------------------------------------
# Gates the admin console's "Sync from Neon" button. With this false the
# endpoint answers 404 rather than reaching for the network, so a local session
# can never pull production data by accident.
SYNC_FROM_PRODUCTION=true

# ---------------------------------------------------------------------------
# The owner account's first console password
# ---------------------------------------------------------------------------
# `npm run db:seed` creates the owner account. Its password is generated and
# written to the `email_outbox` table unless one is pinned here.
#
# Set both, never just the first: a password typed by a human is refused without
# a date for the weekly rotation to take it back, so a pinned password cannot
# quietly become permanent. The hold has to be in the future and no more than
# seven days away.
# OWNER_PINNED_PASSWORD=
# OWNER_PINNED_HOLD_UNTIL=2026-10-11T00:00:00.000Z

# ---------------------------------------------------------------------------
# Connection pool
# ---------------------------------------------------------------------------
# One connection is deliberate. Every request here is a single short query, and
# on a pooled Neon endpoint a second connection buys nothing but a second
# compute slot. Raise it only if you have a reason to.
DATABASE_POOL_MAX=1
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECT_TIMEOUT_MS=8000
DATABASE_STATEMENT_TIMEOUT_MS=0